; font.xon -- the windowed front-end's letters, every set's: the 95
; printable characters, each 8 by 8, in one colour the front-end tints.
;
; (size W H) is each letter's cell.  (letter CODE (rows ...)) draws the
; character with that code; "#" is ink, "." is clear.  A letter sits in
; columns 1 to 5, capitals on rows 0 to 6, descenders on row 7, so a
; line of 80 letters fills the 640-pixel screen.

(size 8 8)

(colour "." 0 0 0 0)
(colour "#" 255 255 255)

; space
(letter 32 (rows
  "........"
  "........"
  "........"
  "........"
  "........"
  "........"
  "........"
  "........"))

; !
(letter 33 (rows
  "...#...."
  "...#...."
  "...#...."
  "...#...."
  "...#...."
  "........"
  "...#...."
  "........"))

