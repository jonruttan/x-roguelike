; items.xon -- the kettle set: what is found in the valley.
;
; The classes and effects are the engine's (see data/classic/items.xon);
; potions and scrolls are known on sight here, so only wands and rings
; wear guises.  An item's (depth LO HI) is the rings, out from the
; square, where it may lie; the caches in game.xon draw from these.

(item potion "mending" (rarity 30) (depth 0 5) (effect heal 8 16))
(item potion "vigour" (rarity 8) (depth 2 5) (effect strength 1))
(item potion "clear sight" (rarity 10) (depth 1 5) (effect seeing 60))

(item scroll "survey" (rarity 20) (depth 0 5) (effect mapping))
(item scroll "blink" (rarity 10) (depth 1 5) (effect teleport))

(item wand "sparks" (rarity 8) (depth 2 5) (charges 3 6) (effect bolt 4 10))

(item ring "warding" (rarity 6) (depth 3 5) (bonus protection 1))

(item weapon "walking staff" (rarity 14) (depth 0 3) (damage 1 4))
(item weapon "hatchet" (rarity 12) (depth 1 5) (damage 1 6))
(item weapon "billhook" (rarity 8) (depth 2 5) (damage 2 7))

(item armour "waxed coat" (rarity 12) (depth 0 3) (armour 1))
(item armour "leather jerkin" (rarity 8) (depth 2 5) (armour 2))

(item food "bread" (rarity 14) (depth 0 5) (nutrition 21600) (single "loaf of bread") (plural "loaves of bread"))
(item food "cheese" (rarity 8) (depth 0 5) (nutrition 14400) (single "wedge of cheese") (plural "wedges of cheese"))
(item oil "oil flask" (rarity 6) (depth 0 5) (oil 300))

(guise wand "ash" "hazel" "elm" "yew")
(guise ring "tin" "horn" "bone" "silver")

; What the people trade (see scenes.xon): never drawn for a screen.  A
; token that no scene gives lies on the ground at the chain's end, or
; with its (carrier "kind").
