; creatures.xon -- the kettle set: what is met in the valley, by its
; distance from the town on the hub.
;
; The traits are the engine's (see data/classic/creatures.xon and
; data/delve/creatures.xon).  Nothing has (depth 0 ...): the fields round
; the town are safe.

; A screen or two out: the farms and the road.
(creature "farm dog" "d" (depth 1 2) (level 1) (hp 3 6) (attack 1 3) (defence 3) (exp 2) (traits skittish) (tale "A farm dog: the farms' own, and no friend to strangers."))
(creature "field adder" "s" (depth 1 3) (level 1) (hp 2 5) (attack 1 3) (defence 4) (exp 4) (traits venom) (tale "A field adder: the dale's adder, out on the warm stones."))
(creature "crow" "c" (depth 1 4) (level 1) (hp 2 4) (attack 1 2) (defence 6) (exp 2) (pack 2 4) (traits erratic fast) (tale "A crow: the farms' own, at the seed and the lambs."))
(creature "road thief" "t" (depth 1 3) (level 2) (hp 5 9) (attack 1 4) (defence 4) (exp 6) (traits thief) (tale "A road thief: the pit is stopped and men are hungry."))

; Farther: the hills, the bog and the woods.
(creature "hornet nest" "N" (depth 2 4) (level 2) (hp 6 10) (attack 1 3) (defence 2) (exp 5) (traits stationary) (tale "A hornet nest: in a hollow tree, and angry in a dry year."))
(creature "hill wolf" "w" (depth 2 5) (level 3) (hp 7 12) (attack 2 5) (defence 5) (exp 10) (pack 2 3) (tale "A hill wolf: the wild hills' own."))
(creature "bog light" "b" (depth 2 3) (level 3) (hp 4 8) (attack 1 4) (defence 7) (exp 9) (traits erratic dazzle wakeful) (tale "A bog light: marsh gas over the bog, kin to the Candle.  Only the" "shepherds call it uncanny."))
(creature "wild boar" "B" (depth 2 3) (level 4) (hp 12 18) (attack 3 7) (defence 5) (exp 18) (tale "A wild boar: out of the woods, and not for turning."))

; Farthest: the Guild's men, who would rather the ledger stayed lost.
(creature "Guild bailiff" "G" (depth 4 5) (level 5) (hp 14 22) (attack 3 8) (defence 6) (exp 30) (ranged 2 5) (shot "a bolt") (traits ranged) (tale "A Guild bailiff: the Guild's hired man, with bolts, about its dig" "on the rim."))

; The people: each talks when walked into, and is placed by the chain
; (see scenes.xon); one that talks is never drawn for a screen.
