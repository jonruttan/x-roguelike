; creatures.xon -- the kettle set: what is met in the valley, by its
; distance from Kettle's square.
;
; The traits are the engine's (see data/classic/creatures.xon and
; data/delve/creatures.xon).  Nothing has (depth 0 ...): the square is
; safe.

; A screen or two out: the farms and the road.
(creature "farm dog" "d" (depth 1 2) (level 1) (hp 3 6) (attack 1 3) (defence 3) (exp 2) (traits skittish))
(creature "field adder" "s" (depth 1 3) (level 1) (hp 2 5) (attack 1 3) (defence 4) (exp 4) (traits venom))
(creature "crow" "c" (depth 1 4) (level 1) (hp 2 4) (attack 1 2) (defence 6) (exp 2) (pack 2 4) (traits erratic fast))
(creature "road thief" "t" (depth 1 3) (level 2) (hp 5 9) (attack 1 4) (defence 4) (exp 6) (traits thief))

; Farther: the hills, the bog and the woods.
(creature "hornet nest" "N" (depth 2 4) (level 2) (hp 6 10) (attack 1 3) (defence 2) (exp 5) (traits stationary))
(creature "hill wolf" "w" (depth 2 5) (level 3) (hp 7 12) (attack 2 5) (defence 5) (exp 10) (pack 2 3))
(creature "bog light" "b" (depth 3 5) (level 3) (hp 4 8) (attack 1 4) (defence 7) (exp 9) (traits erratic dazzle wakeful))
(creature "wild boar" "B" (depth 3 5) (level 4) (hp 12 18) (attack 3 7) (defence 5) (exp 18))

; Farthest: the Guild's men, who would rather the ledger stayed lost.
(creature "Guild bailiff" "G" (depth 4 5) (level 5) (hp 14 22) (attack 3 8) (defence 6) (exp 30) (ranged 2 5) (shot "a bolt") (traits ranged))
