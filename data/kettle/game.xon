; Classes known without being tried.
(known potion scroll)

; The rings out from the town as bands, (band NAME TO . PROPS), the
; first from the hub, each after it from the ring after the one before
; to TO: its word on first arrival, its colour, (where "TEXT") the
; people's words for where a thing in it lies, and its caches, (cache
; CLASS LO HI), that many things of CLASS a screen, each laid with a
; keeper beside it.  Any other form a band names is in front of the
; set's on its screens, and each band carves its screens in its own
; shape, (level-style STYLE): the town's own fields round its door are
; hedged closes; the farms are hedged fields either side of the road;
; the hills gritstone edges and bog; the rim limestone scars, shakeholes
; and the well-keepers' ruins.
(band "Kettle" 0 (colour 70)
  (level-style fields) (where "just outside the town"))
(band "The Farms" 1 (colour 70) (level-style fields) (where "out in the farms")
  (enter "The farms: hedged fields and the road, the town at your back.")
  (cache potion 1 2) (cache food 1 1) (cache weapon 0 1))
(band "The Hills" 3 (colour 64) (level-style hills) (where "up in the hills")
  (enter "The hills: sheep tracks through the gorse, and the bog in the low ground.")
  (cache potion 1 2) (cache food 0 1) (cache scroll 0 1) (cache armour 0 1) (cache wand 0 1))
(band "The Far Valley" 5 (colour 94) (level-style rim) (where "over in the far valley")
  (enter "The far valley: the old city's stones, and the Guild's men about them.")
  (cache potion 1 2) (cache wand 0 1) (cache ring 0 1) (cache armour 0 1))
