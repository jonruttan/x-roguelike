; creatures.xon -- kettle's creatures drawn: the dale's animals, the
; Guild's men, and the town's people by their trades.  Wool, leather,
; linen and fustian, worn and patched; the Guild's people in better
; cloth.  The ground is in tiles.xon, which names "." clear.

; outline, wool and leather
(colour "0" 37 29 25)
(colour "1" 100 72 51)
(colour "2" 151 106 63)
(colour "3" 194 148 84)
; skin, grey hair
(colour "4" 232 188 147)
(colour "5" 192 142 109)
(colour "6" 206 198 179)
; grey wool, iron
(colour "7" 80 80 90)
(colour "8" 127 127 135)
(colour "9" 158 166 176)
(colour "!" 225 227 225)
; linen, tallow, flour
(colour "?" 240 232 200)
(colour "%" 207 194 158)
(colour "&" 249 246 234)
; flame
(colour "*" 255 247 134)
(colour "+" 255 187 14)
; fustian greens, red cloth
(colour "=" 79 106 69)
(colour "@" 128 156 84)
(colour "~" 215 65 40)
(colour "^" 171 62 48)
; the Guild's blue broadcloth, black mourning and good coats
(colour ":" 87 106 151)
(colour "<" 128 148 195)
(colour ">" 56 53 62)
; wood, wicker, brass
(colour "/" 168 118 56)
(colour "|" 206 161 87)
(colour "`" 235 203 70)
(colour "$" 246 211 62)
; marsh gas
(colour "'" 217 252 227 200)
(colour "," 152 233 199 110)
; hide and fur, eye-shine
(colour "-" 208 152 75)
(colour "_" 157 153 142)
(colour "#" 253 244 142)
; adder, hornet, boar
(colour "[" 77 67 51)
(colour "]" 198 179 112)
(colour "{" 248 220 2)
(colour "}" 115 89 69)

