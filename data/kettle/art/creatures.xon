; creatures.xon -- kettle's creatures drawn: the dale's animals, the
; Guild's men, and the town's people by their trades.  Wool, leather,
; linen and fustian, worn and patched; the Guild's people in better
; cloth.  The ground is in tiles.xon, which names "." clear.

; outline, wool and leather
(colour "0" 18 15 14)
(colour "1" 52 40 32)
(colour "2" 84 62 44)
(colour "3" 120 92 62)
; skin, grey hair
(colour "4" 166 128 104)
(colour "5" 118 88 72)
(colour "6" 140 134 122)
; grey wool, iron
(colour "7" 44 44 48)
(colour "8" 74 74 78)
(colour "9" 100 104 110)
(colour "!" 168 170 168)
; linen, tallow, flour
(colour "?" 188 178 150)
(colour "%" 140 130 108)
(colour "&" 214 208 190)
; flame
(colour "*" 250 210 120)
(colour "+" 214 130 50)
; fustian greens, red cloth
(colour "=" 46 58 42)
(colour "@" 78 92 58)
(colour "~" 128 46 36)
(colour "^" 92 40 34)
; the Guild's blue broadcloth, black mourning and good coats
(colour ":" 52 60 82)
(colour "<" 80 90 118)
(colour ">" 30 28 32)
; wood, wicker, brass
(colour "/" 96 70 44)
(colour "|" 132 102 66)
(colour "`" 170 140 70)
(colour "$" 190 150 70)
; marsh gas
(colour "'" 170 220 180 200)
(colour "," 110 170 140 110)
; hide and fur, eye-shine
(colour "-" 132 96 60)
(colour "_" 96 94 88)
(colour "#" 220 200 120)
; adder, hornet, boar
(colour "[" 40 36 30)
(colour "]" 128 116 80)
(colour "{" 196 160 50)
(colour "}" 62 50 42)

