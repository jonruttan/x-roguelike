; tui.xon -- the kettle set: how the terminal draws it.
;
; A front-end's own forms; nothing else reads them.  (glyph WHAT "g")
; is what stands for WHAT: a kind of terrain, a class of item, the
; player.  (colour KIND N) is a kind of terrain's colour, 0-255; a kind
; with no glyph or colour of its own looks like the kind it is a sort
; of (see roguelike/map).

(glyph floor ".")
(glyph wall "#")
(glyph door "+")
(glyph passage ".")
(glyph down ">")
(glyph up "<")
(glyph player "@")
(glyph potion "!")
(glyph scroll "?")
(glyph wand "/")
(glyph ring "=")
(glyph weapon ")")
(glyph armour "[")
(glyph food ":")
(glyph oil "(")
(glyph gold "$")
(glyph goal "*")
(glyph page "%")
(glyph token "'")
(glyph trap "^")

; The farms' hedges, gates and hedgerow trees; the hills' gritstone and
; bog; water; the rim's limestone scars and the well-keepers' stones.
(colour hedge 28)
(colour gate 94)
(colour thicket 22)
(colour edge 137)
(colour bog 58)
(colour water 32)
(colour scar 252)
(colour dressed 245)
