; messages.xon -- the kettle set: what the game says.

(message welcome "Kettle's square, by the well-head.  Someone here knows where the Guild's ledger is; ask about.")
(message won "You lay the ledger on the well-head.  Kettle has its proof, and the Guild has lost its mine.")
(message edge "The valley ends here.")
(message world-map "The valley:")
(message found-goal "The Guild ledger!  Bring it back to the square.")
(message no-stairs "There are no stairs in the open air.")
(message creature-near "You see {a-name}.")
(message explored "Nothing more to see on this screen.")

; The score's lines at the end, one for each the set's (score ...) counts.
(message score-gold "{points} for {count} gold")
(message score-quests "{points} for errands run: {count}")
(message score-screens "{points} for screens of the valley walked: {count}")
(message score-places "{points} for doors gone through: {count}")
(message score-won "{points} for the ledger on the well-head")
