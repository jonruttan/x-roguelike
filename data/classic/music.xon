; music.xon -- the classic set's soundtrack: the Sunken Vault's song, its
; air and its fight song, as tracker songs (docs/sound.md).  The vault
; has no bands, so each is the "default" place's.

(music "default" "vault")
(fight "default" "vault-fight")
(fight-turns 8)

; --- the vault: E phrygian, slow, a harp over a low organ -----------------------

; Calm, a choir of two hums behind it; under tension a muffled toll
; and a flat second that will not resolve.
(song "vault" (bpm 56) (rows 2) (tension-bpm 44)
  (instrument organ (wave hollow) (cut 10) (env (0 0) (1500 40) (5000 32)) (release 2500) (gain 34)
    (voice (detune -4) (pan -40)) (voice (detune 4) (pan 40)))
  (instrument harp (wave glass) (cut 35) (env (0 0) (3 46) (400 20) (2000 0)) (release 600) (gain 24) (pan 20))
  (instrument choir (layer calm) (wave warm) (cut 12) (env (0 0) (2500 30) (6000 26)) (release 3000) (gain 24)
    (voice (detune -7) (pan -55)) (voice (detune 7) (pan 55)))
  (instrument toll (layer tension) (wave metal) (note "E3") (cut 20) (env (0 0) (4 50) (2500 0)) (release 800) (gain 26) (pan -20))
  (instrument flat (layer tension) (wave pulse) (cut 16) (env (0 0) (1200 22) (3000 18)) (release 1500) (gain 18) (pan 15) (width (0 10) (3000 30)))
  (pattern va
    (organ "E2 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (harp  "E4 .  G4 .  B4 .  .  .  F4 .  .  .  E4 .  .  .")
    (choir "B3 .  .  .  .  .  .  .  G3 .  .  .  .  .  .  .")
    (toll  "C4 .  .  .  .  .  .  .  C4 .  .  .  .  .  .  .")
    (flat  "F3 .  .  .  .  .  .  .  .  .  .  .  .  .  .  ."))
  (pattern vb
    (organ "D2 .  .  .  .  .  .  .  C2 .  .  .  .  .  .  .")
    (harp  "D4 .  F4 .  A4 .  .  .  G4 .  E4 .  C4 .  .  .")
    (choir "A3 .  .  .  .  .  .  .  G3 .  .  .  .  .  .  .")
    (toll  "C4 .  .  .  .  .  .  .  C4 .  .  .  C4 .  .  .")
    (flat  "F3 .  .  .  .  .  .  .  E3 .  .  .  .  .  .  ."))
  (pattern vc
    (organ "F2 .  .  .  .  .  .  .  E2 .  .  .  .  .  .  .")
    (harp  "A4 .  F4 .  C5 .  .  .  B4 .  .  .  G4 .  F4 .")
    (choir "C4 .  .  .  .  .  .  .  B3 .  .  .  .  .  .  .")
    (toll  "C4 .  .  .  C4 .  .  .  C4 .  .  .  C4 .  .  .")
    (flat  "F#3 . .  .  .  .  .  .  F3 .  .  .  .  .  .  ."))
  (order va va vb vc))

; The vault's air: water moving behind the walls, and a low hum of the
; stone.  Under tension the water slows to a pulse and a high note
; rings in it.
(song "vault-air" (bpm 60) (rows 1)
  (instrument water (wave noise) (hz 1) (env (0 0) (3000 30) (8000 26)) (release 4000) (gain 30)
    (voice (cut 3) (pan -50) (filter (0 70) (4000 100) (8000 60)))
    (voice (cut 5) (pan 50) (detune 20) (filter (0 100) (3500 55) (8000 90))))
  (instrument stone (wave sine) (env (0 0) (3000 16)) (release 3000) (gain 20))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 55)) (release 3000) (gain 40))
  (instrument ring (layer tension) (wave sine) (note "F6") (env (0 0) (4000 5) (8000 3)) (release 2000) (gain 7))
  (pattern a
    (water "C4 . . . . . . .")
    (stone "E1 . . . . . . .")
    (dread "C4 . . . . . . .")
    (ring  "C4 . . . . . . ."))
  (order a))

; --- the fight: E phrygian, fast, a drum under a stabbing bass ------------------

(song "vault-fight" (bpm 168) (rows 2) (tension-bpm 24)
  (instrument kick (wave sine) (hz 70) (slide 36) (env (0 0) (2 95) (110 0)) (release 30) (gain 60))
  (instrument snare (wave noise) (hz 1) (cut 45) (env (0 0) (1 60) (110 0)) (release 30) (gain 32))
  (instrument hats (wave metal) (note "C8") (cut 90) (env (0 0) (1 18) (25 0)) (release 10) (gain 12) (pan 30))
  (instrument open (layer tension) (wave metal) (note "A7") (cut 80) (env (0 0) (1 20) (130 0)) (release 30) (gain 12) (pan -30))
  (instrument bass (wave pulse) (cut 18) (env (0 0) (3 62) (110 34) (240 0)) (release 50) (gain 38) (width (0 20) (240 50)))
  (instrument harp (wave glass) (cut 40) (env (0 0) (2 36) (300 0)) (release 120) (gain 18) (pan -25))
  (pattern fa
    (kick  "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4")
    (snare ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  .  C4 .")
    (hats  "C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4")
    (open  ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4")
    (bass  "E1 E1 E2 E1 F1 F1 F2 F1 E1 E1 E2 E1 D1 D1 F1 F1")
    (harp  "E4 .  G4 .  B4 .  .  .  F4 .  .  .  E4 .  .  ."))
  (pattern fb
    (kick  "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4 C4 C4")
    (snare ".  .  C4 .  .  .  C4 .  C4 .  C4 C4 C4 C4 C4 C4")
    (hats  "C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 .  .  .  .")
    (open  ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  .  .  .")
    (bass  "C1 C1 C2 C1 D1 D1 D2 D1 F1 F1 F2 F1 E1 E1 E2 E2")
    (harp  "C5 .  B4 .  A4 .  .  .  G4 .  F4 .  E4 .  .  ."))
  (order fa fa fa fb))
