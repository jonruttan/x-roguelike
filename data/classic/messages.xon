; messages.xon -- the classic set: what the game says.
;
; (message KEY "TEXT"): a {name}, {n}, {letter}, {level} or {what} in the
; text is filled in.  A key the set leaves out is said in the engine's
; own words; these are the ones this set puts its own way.

(message welcome "You descend into the Sunken Vault.  Find the Sunstone, and bring it back up.")
(message won "You climb into daylight with the Sunstone.  The vault is behind you.")
(message hit "You hit the {name}.")
(message miss "You miss the {name}.")
(message kill "You have slain the {name}.")
(message creature-hit "The {name} hits you.")
(message creature-miss "The {name} misses you.")
(message hungry "You are getting hungry.")
(message weak "You are weak with hunger.")
(message faint "You faint from lack of food.")
(message starved "starved to death")
(message stairs-down "You descend to level {level}.")
(message stairs-up "You climb to level {level}.")
(message no-way-up "The way up is sealed.  Only the Sunstone can open it.")
(message no-stairs "There are no stairs here.")
(message found-goal "The Sunstone is yours!  Now climb back to the light.")
