; marks.xon -- marks drawn over the player for a state it is in: a
;   condition, its hunger, its wounds.  Mostly clear, in the set's own
;   colours, several at once; the read and the form as tiles.xon.

(colour "m" 240 240 232)
(colour "+" 175 220 255)
(colour "@" 90 150 225)
(colour "~" 255 226 92)
(colour "^" 206 44 40)

