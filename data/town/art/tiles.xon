; tiles.xon -- the town set drawn, for a windowed front-end: Kettle's
; streets in a dry summer, the pit stopped.  Soot-dark gritstone and
; slate, setts underfoot.
;
; Read by the graphical front-end only; the form is the delve set's (see
; data/delve/art/tiles.xon and docs/graphics.md).  The colours are
; kettle's (see data/kettle/art/tiles.xon).

(size 16 16)

(colour "." 0 0 0 0)
(colour "k" 16 13 12)
; gritstone, soot-dark in the town, weathered paler on the edges
(colour "d" 38 34 32)
(colour "r" 62 56 50)
(colour "R" 86 78 68)
(colour "h" 124 112 94)
; stone slate
(colour "n" 34 36 42)
(colour "N" 60 64 72)
; setts and their joints
(colour "e" 30 28 27)
(colour "f" 62 58 54)
(colour "F" 82 77 70)
; grass, hedge, hay, gorse, haws
(colour "v" 30 40 24)
(colour "s" 42 52 30)
(colour "g" 58 70 40)
(colour "G" 76 88 50)
(colour "a" 92 106 56)
(colour "H" 150 138 86)
(colour "X" 196 168 64)
; clay, mud, a cart track
(colour "u" 72 55 42)
(colour "m" 74 60 44)
