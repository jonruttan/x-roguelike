; tiles.xon -- the town set drawn, for a windowed front-end: Kettle's
; streets in a dry summer, the pit stopped.  Soot-dark gritstone and
; slate, setts underfoot.
;
; Read by the graphical front-end only; the form is the delve set's (see
; data/delve/art/tiles.xon and docs/graphics.md).  The colours are
; kettle's (see data/kettle/art/tiles.xon).

(size 16 16)

(colour "." 0 0 0 0)
(colour "k" 33 25 22)
; gritstone, soot-dark in the town, weathered paler on the edges
(colour "d" 72 63 58)
(colour "r" 112 100 85)
(colour "R" 147 131 110)
(colour "h" 193 174 142)
; stone slate
(colour "n" 62 67 82)
(colour "N" 103 112 129)
