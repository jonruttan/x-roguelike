(colour "y" 132 98 66)
; heather, peat, bog
(colour "E" 70 48 62)
(colour "j" 118 76 104)
(colour "b" 42 34 28)
(colour "z" 50 54 36)
; limestone, yew
(colour "q" 104 102 96)
(colour "l" 150 148 136)
(colour "A" 196 192 178)
(colour "x" 24 34 28)
; water
(colour "w" 34 48 58)
(colour "W" 70 96 110)
; timber, iron, rust, wool and cloth
(colour "t" 66 47 32)
(colour "T" 98 74 50)
(colour "V" 122 94 64)
(colour "i" 50 52 56)
(colour "I" 92 94 98)
(colour "J" 128 124 116)
(colour "O" 100 58 34)
(colour "U" 102 80 60)
(colour "c" 52 56 62)
(colour "C" 82 88 96)
(colour "D" 132 44 36)
; skin, bone and paper, lamp light, coin
(colour "p" 168 132 108)
(colour "P" 120 90 76)
(colour "B" 200 190 164)
(colour "Q" 214 164 86)
(colour "L" 246 220 156)
(colour "o" 176 138 58)
(colour "Y" 228 196 110)
; shade, a panel's ground
(colour "S" 0 0 0 110)
(colour "K" 0 0 0 55)
(colour "Z" 18 15 13 232)

