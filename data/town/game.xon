; game.xon -- the town set: Kettle, the market town on the valley floor,
; over the Delve.  Five screens of streets at two metres a cell, each a
; district: the square, the pithead at the top of the main street, the
; river end at the bottom, the terraces to the east and Guild Street to
; the west (see docs/delve.md, The town).
;
; The kettle set joins this one as a region of its world: the town's
; door is on the valley's hub, and a game of kettle starts through it,
; on the square.  A step off the town's edge is out onto that door.
; Nothing hostile walks the streets; what the town holds is its people.

(set "town")
(title "Kettle")
(scale 2)

; A world of screens three by three, of which the town names five: the
; square in the middle, a district a step off each of its sides.
(world screens 3 3)

; The Delve lies under the pithead: the set beside this one, a region of
; the same world, gone into by the pit's door (see the Pithead below).
(join "delve")

(player 14 16)
(unarmed 1 3)
; Food in seconds, a turn the time to walk a cell: half a day's at the
; start; felt with four hours left, weakening with one; a day's the
; most.  Past nothing, (starve N) costs a hit point every N seconds.
(hunger 43200 14400 3600 86400)
(starve 600)
(view 8)

; Streets and terraces, in metres: rows of brick terraces under slate,
; a house four to six metres along, a street between the rows.
(level-style town)
(terrace-depth 9 12)
(terrace-length 24 56)
(house-width 4 6)
(lane 2 3)
(street 3 5)
(square 30 12)

(creatures 0 0)
(items 0 0)
(gold 0 0 0)
(exp 10)
(regen 30)
(known potion scroll)

; The town as one band, so its walls and setts are drawn as the town's.
(band "Kettle" 1)

; The districts: (screen NAME (X Y) . PROPS), its PROPS in front of the
; set's on that screen, its (enter "TEXT") said the first time there.
; Each names its buildings, (building NAME (size W D) (enter "TEXT")),
; W metres along and D deep, laid round its square in order, the text
; said at the door, and its (keeper NAME LINE ...), who stands inside
; unless the chain sends them out and, walked into, says the lines.
(screen "the Square" (1 1)
  (square 90 36)
  (building "the council house" (size 20 15)
    (enter "The council house: the town's officers and its copy of the charter.")
    (keeper "town surveyor" "The town's charter is kept here, and the levels are mine." "The water in the lower galleries rises a hand a week."))
  (building "the inn" (size 26 21)
    (enter "The inn: carriers' talk, and stables for the packhorse trains.")
    (keeper "innkeeper" "Carriers still come over the pass, fewer each month." "The yard takes a packhorse train, when there is one."))
  (building "the pump-house" (size 8 9)
    (enter "The pump-house, the Guild's: the pump's rods come up through it.")))
(screen "the Pithead" (1 0)
  (enter "The pithead: the engine house cold, the gin still, the Tip black.")
  (square 120 45)
  (building "the engine house" (size 12 15)
    (enter "The engine house: the beam out through the wall, the rods hanging.")
    (keeper "engine-wright" "The engine came over the pass in pieces, two summers on the wagons." "No coal, no steam, no pumps, and the water rises."))
  (building "the boiler house" (size 8 9)
    (enter "The boiler house, and the brick chimney above it, cold."))
  (building "the smithy" (size 12 12)
    (enter "The smithy: the forge cold for want of coal.")
    (keeper "smith" "Every iron thing the pit uses, I made, and the forge is cold." "Bring me coal and I'll shoe your horse."))
  (interior "pit" (depth 1 1) (chance 100) (region "delve")
    (enter "The winding shaft: the cage gone, ladders down into the dark, and water loud below.")))
(screen "the River End" (1 2)
  (enter "The river end: the mill race low, the ropewalk, the tannery's reek.")
  (house-width 5 8) (terrace-length 20 40) (lane 3 6) (square 40 12)
  (building "the mill" (size 24 15)
    (enter "The mill, the race low under its wheel.")
    (keeper "miller" "The race is low, and the wheel turns when it likes."))
  (building "the tannery" (size 16 12)
    (enter "The tannery, and its reek.")
    (keeper "tanner" "Bark from the woods and hides from the farms; the reek is mine."))
  (building "the ropewalk" (size 80 6)
    (enter "The ropewalk, long and low, the hemp hanks hung.")))
(screen "the Terraces" (2 1)
  (enter "The terraces: the miners' rows, doors shuttered, the chapel beyond.")
  (terrace-length 40 100) (house-width 4 5) (street 4 6) (square 2 2)
  (building "the chapel" (size 16 15)
    (enter "The miners' chapel, plain stone, and the Long Row in its graveyard.")
    (keeper "chapel warden" "The Long Row: every stone with the same day on it." "The dead who cannot go down are in the water, the chapel says."))
  (building "the bakehouse" (size 8 9)
    (enter "The bakehouse, the town's common oven, warm one day in three.")
    (keeper "baker" "No coal, so it's wood, and the oven lit one day in three.")))
(screen "Guild Street" (0 1)
  (enter "Guild Street: the Guild hall, the White Church, the Guild's shop.")
  (terrace-depth 12 18) (house-width 8 16) (terrace-length 24 48) (street 6 9) (square 30 15)
  (building "the Guild hall" (size 30 15)
    (enter "The Guild hall: gritstone, the council chamber and the pay office.")
    (keeper "councillor" "The Guild built this hall of gritstone; its pay office is empty."))
  (building "the White Church" (size 20 15)
    (enter "The White Church, gritstone, where the Guild's families worship.")
    (keeper "deacon" "The Guild's families worship here, as the Plain does."))
  (building "the Guild's shop" (size 12 9)
    (enter "The Guild's shop, open and selling dear, on credit against wages.")
    (keeper "Guild clerk" "Tickets, good only here, and the shop takes them still." "On credit against wages, and the wages don't come."))
  (building "the chandler's" (size 8 9)
    (enter "The chandler's: tallow candles and lamp oil, and the smell of fat.")
    (keeper "chandler" "Tallow from the farms' fat; the street smells of it, I know.")))
