; music.xon -- the town set's songs, as tracker songs (docs/sound.md):
; the town's own, the square's murmur under it, and the fight song the
; valley plays too.

(music "default" "town")
(music "Kettle" "town")

(fight "default" "kettle-fight")

; --- Kettle: the square and the main street, C major, walking ---------------

(song "town" (bpm 92) (rows 2) (tension-bpm 40)
  (instrument bass (wave hollow) (cut 14) (env (0 0) (5 40) (300 26) (700 0)) (release 200) (gain 32))
  (instrument pluck (wave reed) (cut 22) (env (0 0) (4 42) (300 20) (900 0)) (release 300) (gain 24) (pan 20))
  (instrument bell (wave glass) (env (0 0) (5 28) (2400 0)) (release 900) (gain 16) (pan -30))
  (instrument pad (layer calm) (wave warm) (cut 14) (env (0 0) (2000 28) (6000 24)) (release 3000) (gain 22)
    (voice (detune -8) (pan -60)) (voice (detune 8) (pan 60)))
  (instrument pulse (layer tension) (wave sine) (cut 40) (env (0 0) (6 85) (180 0)) (release 60) (gain 46))
  (instrument tick (layer tension) (wave noise) (hz 1) (cut 26) (env (0 0) (1 30) (35 0)) (release 20) (gain 20) (pan 35))
  (instrument strain (layer tension) (wave thin) (cut 18) (env (0 0) (900 22) (3000 18)) (release 1500) (gain 18) (pan -15))
  (pattern ta
    (bass   "C2 .  G2 .  C2 .  G2 .  F2 .  C3 .  G2 .  E2 .")
    (pluck  "E4 G4 C5 .  G4 .  E4 .  F4 A4 C5 .  B4 .  G4 .")
    (bell   "C6 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (pad    "E3 .  .  .  .  .  .  .  F3 .  .  .  G3 .  .  .")
    (pulse  "C1 .  .  .  C1 .  .  .  F1 .  .  .  G1 .  G1 .")
    (tick   ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  C4 C4 .")
    (strain "G3 .  .  .  .  .  .  .  Ab3 . .  .  .  .  .  ."))
  (pattern tb
    (bass   "A1 .  E2 .  A1 .  E2 .  D2 .  A2 .  G2 .  G1 .")
    (pluck  "C5 .  B4 A4 .  E4 .  .  F4 .  A4 .  G4 .  .  .")
    (bell   ".  .  .  .  .  .  .  .  G5 .  .  .  .  .  .  .")
    (pad    "C3 .  .  .  .  .  .  .  D3 .  .  .  B2 .  .  .")
    (pulse  "A0 .  .  .  A0 .  .  .  D1 .  .  .  G0 .  G0 .")
    (tick   ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  C4 C4 .")
    (strain "E3 .  .  .  .  .  .  .  F3 .  .  .  .  .  .  ."))
  (order ta tb ta tb))

(song "town-square" (bpm 60) (rows 1)
  (instrument murmur (wave noise) (hz 1) (env (0 0) (3000 26) (8000 22)) (release 4000) (gain 22)
    (voice (cut 12) (pan -50)) (voice (cut 9) (pan 50) (detune 30)))
  (instrument hum (wave sine) (env (0 0) (3000 14)) (release 3000) (gain 16))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 60)) (release 3000) (gain 40))
  (pattern a
    (murmur "C4 . . . . . . .")
    (hum    "C2 . . . . . . .")
    (dread  "C4 . . . . . . ."))
  (order a))

; --- a fight above ground: G minor, 166 beats a minute, with a drum -----------

(song "kettle-fight" (bpm 166) (rows 2) (tension-bpm 24)
  (instrument kick (wave sine) (hz 70) (slide 36) (env (0 0) (2 95) (120 0)) (release 30) (gain 60))
  (instrument snare (wave noise) (hz 1) (cut 45) (env (0 0) (1 62) (110 0)) (release 30) (gain 32))
  (instrument hats (wave noise) (hz 1) (cut 85) (env (0 0) (1 20) (25 0)) (release 10) (gain 13) (pan 30))
  (instrument open (layer tension) (wave noise) (hz 1) (cut 75) (env (0 0) (1 22) (130 0)) (release 30) (gain 14) (pan -30))
  (instrument bass (wave reed) (cut 18) (env (0 0) (3 62) (110 34) (240 0)) (release 50) (gain 42))
  (instrument pipe (wave reed) (cut 30) (env (0 0) (2 40) (150 0)) (release 60) (gain 22) (pan -25))
  (instrument bell (wave glass) (env (0 0) (3 30) (900 0)) (release 300) (gain 16) (pan 30))
  (pattern fa
    (kick  "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4")
    (snare ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  .  C4 .")
    (hats  "C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4")
    (open  ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4")
    (bass  "G1 G1 G2 G1 G1 G1 G2 G1 G1 G1 G2 G1 F1 F1 F#1 F#1")
    (pipe  "G3 .  .  G3 .  .  Bb3 . .  .  G3 .  D4 .  C4 .")
    (bell  "D5 .  .  .  .  .  .  .  .  .  .  .  .  .  .  ."))
  (pattern fb
    (kick  "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4")
    (snare ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  .  C4 .")
    (hats  "C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4")
    (open  ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4")
    (bass  "Eb1 Eb1 Eb2 Eb1 Eb1 Eb1 Eb2 Eb1 D1 D1 D2 D1 D1 D1 F#1 F#1")
    (pipe  "Eb3 . .  Eb3 . .  G3 .  .  .  F#3 . A3 .  D4 .")
    (bell  ".  .  .  .  .  .  .  .  D5 .  .  .  .  .  .  ."))
  (pattern fc
    (kick  "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4 C4 C4")
    (snare ".  .  C4 .  .  .  C4 .  C4 .  C4 C4 C4 C4 C4 C4")
    (hats  "C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 .  .  .  .")
    (open  ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  .  .  .")
    (bass  "G1 G1 G2 G1 G1 G1 G2 G1 Eb1 Eb1 Eb2 Eb1 D1 D1 D2 D2")
    (pipe  "G3 .  .  G3 .  .  Bb3 . Eb3 . .  Eb3 D3 .  F#3 ."))
  (order fa fb fa fc))

; --- under a roof ---------------------------------------------------------------

; The inn and the churches have songs of their own; the rest of the
; buildings play the street's, under their own beds (sounds.xon).
(music "the inn" "inn")
(music "the chapel" "hymn")
(music "the White Church" "hymn")

; The inn: D major, a fiddle over a drum, quick.
(song "inn" (bpm 112) (rows 2) (tension-bpm 30)
  (instrument fiddle (wave reed) (cut 34) (env (0 0) (8 38) (120 26) (300 0)) (release 120) (gain 24) (pan -15))
  (instrument bass (wave hollow) (cut 14) (env (0 0) (5 40) (200 24) (450 0)) (release 150) (gain 30))
  (instrument drum (wave sine) (hz 90) (slide 50) (env (0 0) (2 70) (140 0)) (release 30) (gain 36) (pan 20))
  (instrument pad (layer calm) (wave warm) (cut 14) (env (0 0) (1500 24) (5000 20)) (release 2500) (gain 18)
    (voice (detune -8) (pan -60)) (voice (detune 8) (pan 60)))
  (instrument pulse (layer tension) (wave sine) (cut 40) (env (0 0) (6 85) (180 0)) (release 60) (gain 44))
  (pattern ia
    (fiddle "D5 F#5 A5 F#5 D5 F#5 A5 .  G5 B5 D6 B5 A5 F#5 E5 .")
    (bass   "D2 .  A2 .  D2 .  A2 .  G2 .  D3 .  A2 .  A1 .")
    (drum   "C4 .  .  C4 C4 .  .  .  C4 .  .  C4 C4 .  C4 .")
    (pad    "F#3 . .  .  .  .  .  .  G3 .  .  .  A3 .  .  .")
    (pulse  "D1 .  .  .  D1 .  .  .  G1 .  .  .  A1 .  A1 ."))
  (pattern ib
    (fiddle "E5 G5 B5 G5 E5 G5 B5 .  A5 F#5 D5 F#5 E5 C#5 D5 .")
    (bass   "E2 .  B2 .  E2 .  B2 .  A1 .  E2 .  A2 .  D2 .")
    (drum   "C4 .  .  C4 C4 .  .  .  C4 .  .  C4 C4 .  C4 .")
    (pad    "G3 .  .  .  .  .  .  .  A3 .  .  .  F#3 . .  .")
    (pulse  "E1 .  .  .  E1 .  .  .  A0 .  .  .  D1 .  D1 ."))
  (order ia ib ia ib))

; The chapel and the White Church: F major, slow, three voices on an organ.
(song "hymn" (bpm 56) (rows 1) (tension-bpm 20)
  (instrument high (wave warm) (cut 20) (env (0 0) (300 30) (2000 26)) (release 900) (gain 20)
    (voice (detune -4) (pan -20)) (voice (detune 4) (pan 20)))
  (instrument mid (wave warm) (cut 16) (env (0 0) (300 26) (2000 22)) (release 900) (gain 18) (pan -35))
  (instrument low (wave hollow) (cut 12) (env (0 0) (300 34) (2000 28)) (release 900) (gain 26) (pan 30))
  (instrument pulse (layer tension) (wave sine) (cut 40) (env (0 0) (6 80) (200 0)) (release 60) (gain 40))
  (pattern ha
    (high  "A4 .  G4 .  F4 .  .  .")
    (mid   "F4 .  E4 .  C4 .  .  .")
    (low   "F2 .  C3 .  F2 .  .  .")
    (pulse "F1 .  .  .  F1 .  .  ."))
  (pattern hb
    (high  "A4 .  Bb4 . C5 .  A4 .")
    (mid   "F4 .  F4 .  F4 .  F4 .")
    (low   "F2 .  D3 .  A2 .  F2 .")
    (pulse "F1 .  .  .  F1 .  .  ."))
  (pattern hc
    (high  "G4 .  A4 .  G4 .  F4 .")
    (mid   "E4 .  F4 .  E4 .  C4 .")
    (low   "C3 .  F2 .  C3 .  F2 .")
    (pulse "C1 .  .  .  F1 .  .  ."))
  (pattern hd
    (high  "E4 .  .  .  F4 .  .  .")
    (mid   "C4 .  .  .  C4 .  .  .")
    (low   "C2 .  .  .  F2 .  .  .")
    (pulse "C1 .  .  .  F1 .  .  ."))
  (order ha hb hc hd))

; The beds under a roof: a still room, a fire, an inn's room at its
; fire, a mill race, an engine.
(song "indoors" (bpm 60) (rows 1)
  (instrument hush (wave noise) (hz 1) (cut 3) (env (0 0) (3000 16) (8000 14)) (release 4000) (gain 16))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 60)) (release 3000) (gain 40))
  (pattern a
    (hush  "C4 . . . . . . .")
    (dread "C4 . . . . . . ."))
  (order a))

(song "hearth" (bpm 60) (rows 1)
  (instrument fire (wave noise) (hz 1) (cut 22) (env (0 0) (2000 18) (8000 16)) (release 4000) (gain 18))
  (instrument roar (wave noise) (hz 1) (cut 4) (env (0 0) (2000 22) (8000 20)) (release 4000) (gain 20))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 60)) (release 3000) (gain 40))
  (pattern a
    (fire  "C4 . . . . . . .")
    (roar  "C4 . . . . . . .")
    (dread "C4 . . . . . . ."))
  (order a))

(song "hearth-room" (bpm 60) (rows 1)
  (instrument fire (wave noise) (hz 1) (cut 22) (env (0 0) (2000 16) (8000 14)) (release 4000) (gain 16))
  (instrument murmur (wave noise) (hz 1) (env (0 0) (3000 24) (8000 20)) (release 4000) (gain 20)
    (voice (cut 14) (pan -40)) (voice (cut 11) (pan 40) (detune 30)))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 60)) (release 3000) (gain 40))
  (pattern a
    (fire   "C4 . . . . . . .")
    (murmur "C4 . . . . . . .")
    (dread  "C4 . . . . . . ."))
  (order a))

(song "mill-race" (bpm 60) (rows 1)
  (instrument water (wave noise) (hz 1) (cut 10) (env (0 0) (2000 34) (8000 30)) (release 4000) (gain 30)
    (voice (pan -50)) (voice (pan 50) (detune 40)))
  (instrument wheel (wave sine) (hz 55) (env (0 0) (40 40) (900 0)) (release 300) (gain 26))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 60)) (release 3000) (gain 40))
  (pattern a
    (water "C4 . . . . . . .")
    (wheel "C4 . . C4 . . C4 .")
    (dread "C4 . . . . . . ."))
  (order a))

(song "engine" (bpm 72) (rows 2)
  (instrument beat (wave sine) (hz 48) (slide 40) (env (0 0) (20 50) (400 0)) (release 100) (gain 34))
  (instrument hiss (wave noise) (hz 1) (cut 50) (env (0 0) (60 18) (300 0)) (release 80) (gain 14) (pan 25))
  (instrument hum (wave hollow) (cut 8) (env (0 0) (2000 20)) (release 3000) (gain 18))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 60)) (release 3000) (gain 40))
  (pattern a
    (beat  "C4 . . . C4 . . .")
    (hiss  ". . C4 . . . C4 .")
    (hum   "C2 . . . . . . .")
    (dread "C4 . . . . . . ."))
  (order a))
