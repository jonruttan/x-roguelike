; music.xon -- the town set's songs, as tracker songs (docs/sound.md):
; the town's own, the square's murmur under it, and the fight song the
; valley plays too.

(music "default" "town")
(music "Kettle" "town")

(fight "default" "kettle-fight")

; --- Kettle: the square and the main street, C major, walking ---------------

(song "town" (bpm 92) (rows 2) (tension-bpm 40)
  (instrument bass (wave hollow) (cut 14) (env (0 0) (5 40) (300 26) (700 0)) (release 200) (gain 32))
  (instrument pluck (wave reed) (cut 22) (env (0 0) (4 42) (300 20) (900 0)) (release 300) (gain 24) (pan 20))
  (instrument bell (wave glass) (env (0 0) (5 28) (2400 0)) (release 900) (gain 16) (pan -30))
  (instrument pad (layer calm) (wave warm) (cut 14) (env (0 0) (2000 28) (6000 24)) (release 3000) (gain 22)
    (voice (detune -8) (pan -60)) (voice (detune 8) (pan 60)))
  (instrument pulse (layer tension) (wave sine) (cut 40) (env (0 0) (6 85) (180 0)) (release 60) (gain 46))
  (instrument tick (layer tension) (wave noise) (hz 1) (cut 26) (env (0 0) (1 30) (35 0)) (release 20) (gain 20) (pan 35))
  (instrument strain (layer tension) (wave thin) (cut 18) (env (0 0) (900 22) (3000 18)) (release 1500) (gain 18) (pan -15))
  (pattern ta
    (bass   "C2 .  G2 .  C2 .  G2 .  F2 .  C3 .  G2 .  E2 .")
    (pluck  "E4 G4 C5 .  G4 .  E4 .  F4 A4 C5 .  B4 .  G4 .")
    (bell   "C6 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (pad    "E3 .  .  .  .  .  .  .  F3 .  .  .  G3 .  .  .")
    (pulse  "C1 .  .  .  C1 .  .  .  F1 .  .  .  G1 .  G1 .")
    (tick   ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  C4 C4 .")
    (strain "G3 .  .  .  .  .  .  .  Ab3 . .  .  .  .  .  ."))
  (pattern tb
    (bass   "A1 .  E2 .  A1 .  E2 .  D2 .  A2 .  G2 .  G1 .")
    (pluck  "C5 .  B4 A4 .  E4 .  .  F4 .  A4 .  G4 .  .  .")
    (bell   ".  .  .  .  .  .  .  .  G5 .  .  .  .  .  .  .")
    (pad    "C3 .  .  .  .  .  .  .  D3 .  .  .  B2 .  .  .")
    (pulse  "A0 .  .  .  A0 .  .  .  D1 .  .  .  G0 .  G0 .")
    (tick   ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  C4 C4 .")
    (strain "E3 .  .  .  .  .  .  .  F3 .  .  .  .  .  .  ."))
  (order ta tb ta tb))

(song "town-square" (bpm 60) (rows 1)
  (instrument murmur (wave noise) (hz 1) (env (0 0) (3000 26) (8000 22)) (release 4000) (gain 22)
    (voice (cut 12) (pan -50)) (voice (cut 9) (pan 50) (detune 30)))
  (instrument hum (wave sine) (env (0 0) (3000 14)) (release 3000) (gain 16))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 60)) (release 3000) (gain 40))
  (pattern a
    (murmur "C4 . . . . . . .")
    (hum    "C2 . . . . . . .")
    (dread  "C4 . . . . . . ."))
  (order a))

; --- a fight above ground: G minor, 166 beats a minute, with a drum -----------

(song "kettle-fight" (bpm 166) (rows 2) (tension-bpm 24)
  (instrument kick (wave sine) (hz 70) (slide 36) (env (0 0) (2 95) (120 0)) (release 30) (gain 60))
  (instrument snare (wave noise) (hz 1) (cut 45) (env (0 0) (1 62) (110 0)) (release 30) (gain 32))
  (instrument hats (wave noise) (hz 1) (cut 85) (env (0 0) (1 20) (25 0)) (release 10) (gain 13) (pan 30))
  (instrument open (layer tension) (wave noise) (hz 1) (cut 75) (env (0 0) (1 22) (130 0)) (release 30) (gain 14) (pan -30))
  (instrument bass (wave reed) (cut 18) (env (0 0) (3 62) (110 34) (240 0)) (release 50) (gain 42))
  (instrument pipe (wave reed) (cut 30) (env (0 0) (2 40) (150 0)) (release 60) (gain 22) (pan -25))
  (instrument bell (wave glass) (env (0 0) (3 30) (900 0)) (release 300) (gain 16) (pan 30))
  (pattern fa
    (kick  "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4")
    (snare ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  .  C4 .")
    (hats  "C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4")
    (open  ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4")
    (bass  "G1 G1 G2 G1 G1 G1 G2 G1 G1 G1 G2 G1 F1 F1 F#1 F#1")
    (pipe  "G3 .  .  G3 .  .  Bb3 . .  .  G3 .  D4 .  C4 .")
    (bell  "D5 .  .  .  .  .  .  .  .  .  .  .  .  .  .  ."))
  (pattern fb
    (kick  "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4")
    (snare ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  .  C4 .")
    (hats  "C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4")
    (open  ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4")
    (bass  "Eb1 Eb1 Eb2 Eb1 Eb1 Eb1 Eb2 Eb1 D1 D1 D2 D1 D1 D1 F#1 F#1")
    (pipe  "Eb3 . .  Eb3 . .  G3 .  .  .  F#3 . A3 .  D4 .")
    (bell  ".  .  .  .  .  .  .  .  D5 .  .  .  .  .  .  ."))
  (pattern fc
    (kick  "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4 C4 C4")
    (snare ".  .  C4 .  .  .  C4 .  C4 .  C4 C4 C4 C4 C4 C4")
    (hats  "C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 .  .  .  .")
    (open  ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  .  .  .")
    (bass  "G1 G1 G2 G1 G1 G1 G2 G1 Eb1 Eb1 Eb2 Eb1 D1 D1 D2 D2")
    (pipe  "G3 .  .  G3 .  .  Bb3 . Eb3 . .  Eb3 D3 .  F#3 ."))
  (order fa fb fa fc))
