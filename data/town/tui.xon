; tui.xon -- the town set: how the terminal draws it.
;
; A front-end's own forms; nothing else reads them (see
; data/kettle/tui.xon).

(glyph floor ".")
(glyph wall "#")
(glyph door "+")
(glyph passage ".")
(glyph down ">")
(glyph up "<")
(glyph player "@")
(glyph potion "!")
(glyph scroll "?")
(glyph wand "/")
(glyph ring "=")
(glyph weapon ")")
(glyph armour "[")
(glyph food ":")
(glyph oil "(")
(glyph gold "$")
(glyph goal "*")
(glyph page "%")
(glyph token "'")
(glyph trap "^")
