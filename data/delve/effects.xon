; --- the conditions -------------------------------------------------------------

(condition "confused" (on "woozy") (every "woozy" 3500 26) (steps 0 70 100))
(condition "slowed" (on "slow-down") (every "slow-tick" 1800 24) (steps -500 0 110))
(condition "hasted" (on "quicken") (every "fast-tick" 1100 18) (steps 400 0 80))
(condition "held" (on "strain") (every "strain" 2600 28) (off "free"))
(condition "seeing" (on "clarity") (every "glint" 5000 18) (off "dim"))
(condition "blind" (on "dim") (every "blind-hum" 4000 22) (steps 0 0 130) (off "clarity"))

(sound "woozy" (vary 50) (gain 26)
  (voice (note "A3") (slide "G3") (detune -20) (env (0 0) (200 30) (900 0)) (pan -50))
  (voice (note "A3") (slide "B3") (detune 20) (env (0 0) (200 30) (900 0)) (pan 50)))

(sound "slow-tick" (vary 30) (gain 26)
  (voice (wave hollow) (note "C2") (cut 14) (env (0 0) (4 45) (300 0)))
  (voice (wave noise) (hz 1) (cut 12) (env (0 0) (2 30) (60 0))))

(sound "quicken" (vary 40) (gain 30)
  (voice (wave thin) (note "A3") (slide "A5") (cut 40) (env (0 0) (10 30) (350 0)))
  (voice (wave noise) (hz 1) (cut 40) (env (0 0) (200 25) (350 0))))

(sound "fast-tick" (vary 60) (gain 18)
  (voice (wave noise) (hz 1) (cut 70) (env (0 0) (1 40) (12 0)))
  (voice (wave noise) (hz 1) (cut 70) (at 90) (env (0 0) (1 32) (12 0))))

(sound "strain" (vary 120) (gain 28)
  (voice (wave reed) (note "E2") (slide "F2") (cut 8) (env (0 0) (300 35) (700 0)))
  (voice (wave noise) (hz 1) (cut 5) (env (0 0) (300 20) (600 0))))

(sound "free" (vary 80) (gain 30)
  (voice (wave noise) (hz 1) (cut 40) (env (0 0) (1 50) (60 0)))
  (voice (wave reed) (note "A2") (slide "D3") (cut 20) (env (0 0) (5 30) (200 0))))

(sound "sicken" (vary 60) (gain 30)
  (voice (wave reed) (note "F3") (slide "C#3") (cut 14) (env (0 0) (100 35) (700 0)))
  (voice (note "C4") (slide "F3") (at 200) (env (0 0) (10 25) (200 0))))

(sound "clarity" (gain 26) (echo 160 35 30)
  (voice (wave glass) (note "E5") (slide "E6") (env (0 0) (100 25) (800 0)))
  (voice (wave glass) (note "B5") (at 120) (env (0 0) (4 20) (900 0))))

(sound "glint" (vary 400) (gain 16)
  (voice (wave glass) (note "B6") (env (0 0) (2 20) (500 0))))

(sound "dim" (gain 26)
  (voice (wave glass) (note "E6") (slide "E5") (env (0 0) (50 22) (800 0)))
  (voice (wave hollow) (note "E2") (cut 8) (env (0 0) (200 25) (900 0))))

(sound "blind-hum" (vary 60) (gain 20)
  (voice (wave hollow) (note "C2") (cut 4) (env (0 0) (800 30) (2000 0))))

; --- the bonuses: each ring's own -----------------------------------------------

(bonus "protection" (on "ward-on") (struck "ward"))
(bonus "strength" (on "might-on") (strikes "heft"))
(bonus "regeneration" (on "mend-on") (mends "mend-tick"))
(bonus "stealth" (on "hush-on") (steps 0 0 40))
(bonus "light" (on "glow-on") (every "glow" 6000 18))

; Warding: metal answers a blow that lands.
(sound "ward-on" (gain 26) (echo 140 30 25)
  (voice (wave thin) (note "E5") (env (0 0) (2 30) (900 0)))
  (voice (wave glass) (note "B5") (detune 9) (env (0 0) (2 22) (900 0))))
(sound "ward" (vary 60) (gain 28)
  (voice (wave thin) (note "E6") (env (0 0) (1 30) (500 0)))
  (voice (wave glass) (note "B6") (detune 9) (env (0 0) (1 20) (400 0))))

; Vigour: a weight behind every blow the player lands.
(sound "might-on" (gain 32)
  (voice (wave reed) (note "C2") (cut 14) (env (0 0) (100 40) (700 0)))
  (voice (hz 55) (env (0 0) (100 40) (700 0))))
(sound "heft" (vary 60) (gain 40)
  (voice (hz 60) (slide 35) (env (0 0) (2 80) (220 0)))
  (voice (wave noise) (hz 1) (cut 5) (env (0 0) (2 50) (120 0))))

; Mending: a small rising note each time a wound closes a little.
(sound "mend-on" (gain 26)
  (voice (wave warm) (note "C4") (slide "G4") (cut 20) (env (0 0) (200 30) (700 0))))
(sound "mend-tick" (vary 80) (gain 16)
  (voice (wave glass) (note "G5") (env (0 0) (2 20) (250 0)))
  (voice (wave glass) (note "C6") (at 80) (env (0 0) (2 18) (300 0))))

; Silence: a hush, and the player's own steps quieter.
(sound "hush-on" (gain 24)
  (voice (wave noise) (hz 1) (cut 25) (env (0 0) (300 30) (900 0))))

; Illumination: the stone's light, cold and green, singing faintly.
(sound "glow-on" (gain 26) (echo 200 40 30)
  (voice (wave glass) (note "G#5") (env (0 0) (300 24) (1500 0)))
  (voice (wave glass) (note "D#6") (detune 7) (env (0 0) (400 18) (1500 0))))
(sound "glow" (vary 200) (gain 14)
  (voice (wave glass) (note "G#6") (env (0 0) (400 14) (1600 0)))
  (voice (wave glass) (note "D#7") (detune 11) (at 200) (env (0 0) (400 10) (1400 0))))
