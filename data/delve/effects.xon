(said "drained" "drain")
(said "poisoned" "sicken")
(said "starving" "faint")
(said "faint" "faint")
(said "explored" "explored")
(said "cannot-afford" "nope")
(said "pack-full" "nope")
(said "hands-full" "nope")
(said "no-such-item" "nope")
(said "wrong-kind" "nope")
(said "unknown-key" "nope")
(said "none-such" "nope")
(said "no-stairs" "nope")
(said "no-way-up" "nope")
(said "no-way-on" "nope")
(said "not-wearing" "nope")
(said "already-wearing" "nope")
(said "in-use" "nope")
(said "no-lamp" "nope")
(said "no-words" "nope")
(said "no-world-map" "nope")
(said "nothing-here" "nope")
(said "nothing-to-sell" "nope")
(said "not-bought" "nope")
(said "barred" "nope")
(said "edge" "nope")

(sound "door-creak" (vary 150) (gain 30)
  (voice (wave reed) (note "D2") (slide "G2") (cut 8) (env (0 0) (120 40) (500 0)))
  (voice (hz 140) (slide 100) (cut 30) (at 420) (env (0 0) (1 45) (80 0))))

(sound "stone-grind" (vary 60) (gain 36)
  (voice (wave noise) (hz 1) (cut 3) (env (0 0) (200 60) (900 50) (1300 0)))
  (voice (wave hollow) (note "A1") (slide "G1") (cut 6) (env (0 0) (200 35) (1200 0)))
  (voice (wave glass) (note "E6") (at 1200) (env (0 0) (2 25) (700 0))))

