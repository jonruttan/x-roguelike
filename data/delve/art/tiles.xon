(colour "p" 224 176 146)
(colour "P" 168 118 96)
(colour "b" 176 170 150)
(colour "B" 232 226 206)
; creatures: rat fur, toad, firedamp, the dead
(colour "q" 116 98 88)
(colour "Q" 156 136 120)
(colour "g" 76 112 58)
(colour "G" 130 168 90)
(colour "m" 150 210 200)
(colour "M" 228 255 246)
(colour "j" 150 210 200 90)
(colour "K" 28 38 48 190)
(colour "a" 118 138 150 150)
(colour "A" 200 216 224 190)
; the Lodestar's cold light; a panel's ground
(colour "x" 110 150 190 110)
(colour "Z" 22 18 16 228)

