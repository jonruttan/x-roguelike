; creatures.xon -- the rest of the delve's creatures drawn, by band: the read and the form as tiles.xon.

; an eel lit by the stone's water
(colour "0" 190 254 248)
(colour "1" 79 103 93)
(colour "2" 116 210 198)
; a leech
(colour "3" 100 70 67)
; a shard of the stone's light
(colour "4" 222 250 255)
; the drowned
(colour "5" 97 171 178 150)
; a well-keeper's robe, faded
(colour "6" 174 161 127)
; a bat's wing
(colour "7" 134 100 95)
; a blind white crayfish
(colour "8" 247 243 233)
(colour "9" 212 205 191)
; the Flood's current: foam, deep water
(colour "!" 223 244 245 220)
(colour "?" 31 77 100 230)
; the well-keepers' dressed limestone
(colour "%" 225 218 196)
; a ferret's fur
(colour "&" 231 208 148)

