; bands.xon -- the ground of the Delve's three deeper bands, each tile
; (band "NAME"), in front of the Galleries' ground in tiles.xon on that
; band's levels.  The rims, corners, face ends and shade are tiles.xon's,
; recoloured; the faces, floors, doors and stairs are each place's own.

; colours: the Flood's water, silt and ochre; the Old Works' limestone; the Heart's glassy rock, dripstone and cold light
(colour "*" 238 156 23)
(colour "+" 147 162 166)
(colour "=" 31 58 82)
(colour "~" 170 213 222)
(colour "@" 131 115 79)
(colour ":" 79 74 67)
(colour "^" 135 127 109)
(colour "<" 178 168 146)
(colour ">" 219 210 186)
(colour "/" 239 233 213)
(colour "|" 115 106 92)
(colour "`" 193 182 157)
(colour "'" 163 155 134)
(colour "," 23 29 46)
(colour "_" 49 60 85)
(colour "$" 95 112 144)
(colour "#" 201 237 247)
(colour "[" 214 207 185)
(colour "]" 153 146 129)
(colour "{" 132 229 244)
(colour "}" 22 58 84)

