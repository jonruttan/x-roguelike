; tui.xon -- the delve set: how the terminal draws it.
;
; A front-end's own forms; nothing else reads them.  (glyph WHAT "g")
; is what stands for WHAT: a kind of terrain, a class of item, the
; player.  (colour KIND N) is a kind of terrain's colour, 0-255; a kind
; with no glyph or colour of its own looks like the kind it is a sort
; of (see roguelike/map).

(glyph floor ".")
(glyph wall "#")
(glyph door "+")
(glyph passage ".")
(glyph down ">")
(glyph up "<")
(glyph player "@")
(glyph potion "!")
(glyph scroll "?")
(glyph wand "/")
(glyph ring "=")
(glyph weapon ")")
(glyph armour "[")
(glyph food ":")
(glyph oil "(")
(glyph gold "$")
(glyph goal "*")
(glyph page "%")
(glyph token "'")
(glyph trap "^")

; The pit's coal pillars and roof falls, the old stair's water, the
; shallows standing over the floor, and the well-keepers' dressed
; stone.
(colour pillar 240)
(colour fall 238)
(colour water 32)
(colour shallow 74)
(colour dressed 250)

; What is in view by a ring's light alone, the lamp out: a pale
; sea-green, no lamp's colour.
(colour glow 79)
