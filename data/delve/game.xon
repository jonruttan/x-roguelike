; game.xon -- the delve set: a drowned mine, twelve levels, no hunger.
;
; What this set turns on that classic leaves off: levels carved as
; caves, lit by sight to a radius, potions and scrolls known on sight,
; and no food clock -- the pressure is what wanders in.

(set "delve")
(title "The Delve")

; The Lodestar, twelve levels down; held, it opens the flooded shafts
; back up, each level made again and roused.
(goal "the Lodestar" "*" 12)

(player 14 16)
(unarmed 1 3)

; No hunger: a first value under one turns the clock off.
(hunger 0 0 0)

; Sight to seven cells, through nothing solid.
(view 7)

; Caves: walkers carve until this percent of the level is floor.
(level-style caves)
(cave-fill 38)

(creatures 4 7)
(items 4 7)
(gold 30 8 30)
(exp 10)
(regen 12)
(wander 40)

; Classes known without being tried.
(known potion scroll)

(glyph floor ".")
(glyph wall "#")
(glyph door "+")
(glyph passage ".")
(glyph down ">")
(glyph up "<")
(glyph player "@")
(glyph potion "!")
(glyph scroll "?")
(glyph wand "/")
(glyph ring "=")
(glyph weapon ")")
(glyph armour "[")
(glyph food ":")
(glyph gold "$")
(glyph goal "*")
