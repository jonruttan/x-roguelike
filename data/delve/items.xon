; items.xon -- the delve set: what the miners left.
;
; The classes and effects are the engine's (see data/classic/items.xon);
; potions and scrolls are known on sight here, so only wands and rings
; wear guises.  No food: there is no hunger in the Delve.  The pages
; are in pages.xon.

(item potion "mending" (rarity 30) (effect heal 10 20))
(item potion "deep mending" (rarity 10) (effect heal 25 45))
(item potion "vigour" (rarity 10) (effect strength 1))
(item potion "quickness" (rarity 10) (effect haste 12))
(item potion "clear sight" (rarity 10) (effect seeing 60))
(item potion "restoration" (rarity 8) (effect restore))
(item potion "miasma" (rarity 10) (effect poison 1 2))

(item scroll "survey" (rarity 18) (effect mapping))
(item scroll "blink" (rarity 14) (effect teleport))
(item scroll "temper" (rarity 12) (effect enchant-weapon))
(item scroll "plating" (rarity 12) (effect enchant-armour))
(item scroll "panic" (rarity 8) (effect fear))
(item scroll "stillness" (rarity 8) (effect hold 6))

(item wand "sparks" (rarity 14) (charges 3 7) (effect bolt 5 14))
(item wand "lethargy" (rarity 10) (charges 3 7) (effect slow 10))
(item wand "banishing" (rarity 10) (charges 2 5) (effect teleport-other))
(item wand "leeching" (rarity 8) (charges 2 6) (effect drain 4 10))

(item ring "warding" (rarity 12) (bonus protection 1))
(item ring "vigour" (rarity 10) (bonus strength 1))
(item ring "mending" (rarity 10) (bonus regeneration 1))
(item ring "silence" (rarity 8) (bonus stealth 1))

(item weapon "lantern pole" (rarity 10) (damage 1 4))
(item weapon "pick" (rarity 14) (damage 1 6))
(item weapon "miner's blade" (rarity 12) (damage 2 7))
(item weapon "sledge" (rarity 8) (damage 3 10))

(item armour "oilskin" (rarity 12) (armour 1))
(item armour "boiled leather" (rarity 12) (armour 2))
(item armour "scale coat" (rarity 8) (armour 4))
(item armour "plated harness" (rarity 4) (armour 6))

; What the people below ask for, and what they give: never drawn for a
; level.
(item token "the foreman's lamp" (rarity 0))
(item token "pump valve" (rarity 0))
(item token "pump crank" (rarity 0))
(item token "pump seal" (rarity 0))
(item weapon "foreman's pick" (rarity 0) (damage 3 9))

(guise wand "oak" "bone" "brass" "glass" "iron" "willow" "jet" "copper")
(guise ring "jade" "onyx" "amber" "opal" "iron" "coral" "garnet" "pearl")
