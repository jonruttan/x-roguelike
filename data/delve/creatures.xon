; creatures.xon -- the delve set: what lives in the drowned mine, by band.
;
; Beyond the classic traits: (pack LO HI) puts that many down together;
; ranged lets fly (ranged LO HI) along a line, said as (shot "what");
; summon calls a (summon "name") to its side while you are in view.
; (tale "LINE" ...) is said the first time one is seen in a game, a
; line a message: what it is, and what has changed it; (article
; "WORD") goes before its name where one is met, "a" or "an" without.
; A guardian has (depth 0 0): it is never drawn for a level, only put
; by its band on the band's last level.
;
; A band brings its kinds in a level or two at a time, not all at once:
; level 2 adds the shade and the knocker, level 3 the motes and the
; ferrets.

; The Galleries, 1 to 3: what the mine bred, and one who did not leave.
(creature "mine rat" "r" (depth 1 3) (level 1) (hp 2 5) (attack 1 3) (defence 2) (exp 2) (pack 1 2) (traits erratic) (tale "A mine rat: it came down with the miners and their bait tins," "and has had the galleries to itself since the pumps stopped."))
(creature "drip toad" "t" (depth 1 5) (level 1) (hp 4 8) (attack 1 4) (defence 2) (exp 3) (traits venom slow) (tale "A drip toad: toads breed in any wet working, and this one has" "grown fat in the dark."))
(creature "gas mote" "m" (depth 3 5) (level 2) (hp 1 3) (attack 1 2) (defence 6) (exp 3) (pack 2 5) (traits erratic dazzle wakeful) (tale "A gas mote: firedamp pooled in the roof.  A lamp lights it."))
(creature "knocker" "k" (depth 2 6) (level 2) (hp 4 9) (attack 1 3) (defence 4) (exp 6) (ranged 1 3) (shot "a stone") (traits ranged skittish) (tale "A knocker: the hewers' tale of the thing that knocks in the rock," "left a crust at every shift.  Since the breach it walks, and" "throws stones."))
(creature "pit ferret" "f" (depth 3 3) (level 2) (hp 5 10) (attack 1 5) (defence 3) (exp 5) (pack 1 3) (tale "A pit ferret: bred from the miners' ratters, gone wild below." "They hunt in packs."))
(creature "gallery shade" "g" (depth 2 4) (level 2) (hp 5 9) (attack 1 4) (defence 4) (exp 6) (traits cold slow) (tale "A gallery shade: the firedamp shift, forty years dead, walking" "since the breach."))
(creature "fireman" "F" (depth 0 0) (article "the") (level 3) (hp 20 28) (attack 2 7) (defence 5) (exp 45) (traits cold regen) (tale "The fireman of the firedamp shift: he tested for gas, saw the" "Candle burn tall, and sent them down anyway."))

; The Flood, 4 to 6: what lives in standing water.
(creature "lantern eel" "e" (depth 4 7) (level 3) (hp 8 14) (attack 2 6) (defence 4) (exp 10) (traits dazzle fast) (tale "A lantern eel: a river eel come in with the water, and lit by it."))
(creature "silt crayfish" "C" (depth 4 7) (level 3) (hp 8 14) (attack 1 5) (defence 7) (exp 9) (pack 1 3) (traits slow) (tale "A silt crayfish: blind and white, up from the stone's pool."))
(creature "great leech" "L" (depth 4 8) (level 4) (hp 16 26) (attack 3 9) (defence 5) (exp 20) (traits stationary sticky) (tale "A great leech: it lies in the standing water and holds on."))
(creature "drowned shade" "S" (depth 5 7) (level 5) (hp 10 16) (attack 2 8) (defence 6) (exp 25) (traits invisible cold) (tale "A drowned shade: one of the Flood's dead."))
(creature "undertow" "U" (depth 0 0) (article "the") (level 6) (hp 32 44) (attack 4 10) (defence 6) (exp 90) (traits cold sticky regen) (tale "The undertow: the Flood's current, given a will by the stone's" "water."))

; The Old Works, 7 to 9: the builders' dead, and their keepers.
(creature "old 'un" "o" (depth 7 10) (level 3) (hp 6 12) (attack 1 6) (defence 3) (exp 7) (traits slow) (tale "An old 'un: one of the well-keepers' dead, up out of the ossuary." "The miners call them the old people."))
(creature "cave bat" "b" (depth 7 12) (level 5) (hp 9 15) (attack 2 7) (defence 7) (exp 28) (traits fast erratic) (tale "A cave bat: in through the rim's caves and down the well-keepers'" "stair."))
(creature "ossuary priest" "P" (depth 7 10) (level 5) (hp 12 20) (attack 2 6) (defence 5) (exp 30) (summon "old 'un") (traits summon) (tale "An ossuary priest: a well-keeper priest still at his office," "raising the bones."))
(creature "rust golem" "G" (depth 7 11) (level 7) (hp 30 45) (attack 5 12) (defence 8) (exp 70) (traits slow regen) (tale "A rust golem: a keeper of the walls' stone, bound with bog iron." "Dry for a thousand years; rusting since the breach."))
(creature "warder" "W" (depth 0 0) (article "the") (level 9) (hp 38 52) (attack 5 12) (defence 9) (exp 130) (summon "old 'un") (traits summon slow regen) (tale "The warder: the old people's man of stone, set over the" "Well-House door."))

; The people: each talks when walked into, and asks for something (see
; quests.xon); never drawn for a level.
(creature "lampman" "&" (depth 0 0) (level 1) (hp 1 1) (attack 0 0) (defence 0) (exp 0) (traits talks))
(creature "surveyor" "&" (depth 0 0) (level 1) (hp 1 1) (attack 0 0) (defence 0) (exp 0) (traits talks))
(creature "pump-wright" "&" (depth 0 0) (level 1) (hp 1 1) (attack 0 0) (defence 0) (exp 0) (traits talks))

; The Heart, 10 to 12: what keeps the stone company.
(creature "glister" "X" (depth 9 12) (level 9) (hp 40 60) (attack 6 14) (defence 8) (exp 150) (ranged 4 10) (shot "a shard of light") (traits ranged regen wakeful) (tale "A glister: one of the old people's men, cut from the stone's own" "glassy rock.  It throws shards of the stone's light."))
(creature "glow-midge" "v" (depth 10 12) (level 8) (hp 6 10) (attack 2 6) (defence 8) (exp 22) (pack 2 4) (traits fast erratic dazzle wakeful) (tale "Glow-midges: a swarm lit by the stone's water."))
(creature "Old Man" "O" (depth 0 0) (article "the") (level 11) (hp 55 80) (attack 7 16) (defence 9) (exp 300) (summon "cave bat") (traits summon regen wakeful) (tale "The Old Man: the last of the old people's men, by the pool, who" "calls the bats.  The miners' name for whoever worked the ground" "before them; this is the oldest of all."))
