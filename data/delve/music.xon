; --- The Heart: the stone that moves, the quiet water; C, deep and slow ------

(song "heart" (bpm 48) (rows 2) (tension-bpm 40)
  (instrument deep (wave sine) (env (0 0) (2500 40) (6000 34)) (release 3500) (gain 36)
    (voice (pan -30)) (voice (wave hollow) (cut 8) (pan 30) (gain 70)))
  (instrument bell (wave glass) (env (0 0) (4 30) (3500 0)) (release 1500) (gain 18)
    (voice (pan -40)) (voice (pan 40) (detune 8) (gain 50)))
  (instrument pad (layer calm) (wave warm) (cut 10) (env (0 0) (3000 28) (7000 24)) (release 3500) (gain 24)
    (voice (detune -7) (pan -60)) (voice (detune 7) (pan 60)))
  (instrument pulse (layer tension) (wave sine) (cut 40) (env (0 0) (8 90) (220 0)) (release 60) (gain 54))
  (instrument tick (layer tension) (wave noise) (hz 1) (cut 20) (env (0 0) (1 30) (40 0)) (release 20) (gain 20))
  (instrument strain (layer tension) (wave thin) (cut 14) (env (0 0) (1200 24) (3000 20)) (release 1500) (gain 18) (pan 25))
  (pattern ha
    (deep   "C2 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (bell   "G4 .  .  .  .  .  .  .  .  .  .  .  E5 .  .  .")
    (bell   ".  .  .  .  .  .  C5 .  .  .  .  .  .  .  .  .")
    (pad    "E3 .  .  .  .  .  .  .  D3 .  .  .  .  .  .  .")
    (pulse  "C1 .  .  .  .  .  .  .  C1 .  .  .  C1 .  C1 .")
    (tick   ".  .  .  .  .  .  C4 .  .  .  .  .  .  .  C4 .")
    (strain "Db4 . .  .  .  .  .  .  .  .  .  .  .  .  .  ."))
  (pattern hb
    (deep   "Ab1 . .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (bell   "Eb5 . .  .  .  .  .  .  .  .  .  .  C5 .  .  .")
    (bell   ".  .  .  .  .  .  G4 .  .  .  .  .  .  .  .  .")
    (pad    "C3 .  .  .  .  .  .  .  Eb3 . .  .  .  .  .  .")
    (pulse  "Ab0 . .  .  .  .  .  .  Ab0 . .  .  Ab0 . Ab0 .")
    (tick   ".  .  .  .  .  .  C4 .  .  .  .  .  .  .  C4 .")
    (strain "D4 .  .  .  .  .  .  .  .  .  .  .  .  .  .  ."))
  (order ha ha hb))

(song "heart-air" (bpm 60) (rows 1)
  (instrument air (wave noise) (hz 1) (env (0 0) (3500 30) (9000 26)) (release 4500) (gain 28)
    (voice (cut 1) (pan -50)) (voice (cut 2) (pan 50) (detune 35)))
  (instrument hum (wave sine) (env (0 0) (3500 22)) (release 3500) (gain 24))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 60)) (release 3000) (gain 44))
  (pattern a
    (air   "C4 . . . . . . .")
    (hum   "C1 . . . . . . .")
    (dread "C4 . . . . . . ."))
  (order a))
