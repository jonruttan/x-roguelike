(song "works-fight" (bpm 180) (rows 2) (tension-bpm 22)
  (instrument kick (wave sine) (hz 74) (slide 40) (env (0 0) (2 95) (100 0)) (release 30) (gain 58))
  (instrument clank (wave noise) (hz 1) (cut 60) (env (0 0) (1 58) (80 0)) (release 30) (gain 32) (pan 20))
  (instrument hats (wave noise) (hz 1) (cut 88) (env (0 0) (1 20) (22 0)) (release 10) (gain 13) (pan -30))
  (instrument open (layer tension) (wave noise) (hz 1) (cut 80) (env (0 0) (1 22) (110 0)) (release 30) (gain 14) (pan 30))
  (instrument bass (wave reed) (cut 14) (env (0 0) (2 62) (100 36) (220 0)) (release 50) (gain 42))
  (instrument low (wave hollow) (cut 28) (env (0 0) (3 38) (200 0)) (release 80) (gain 22) (pan -30))
