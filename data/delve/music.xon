    (bell   ".  .  .  .  A4 .  .  .  .  .  .  .  .  .  .  .")
    (pad    "F3 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (pulse  "D1 .  .  .  .  .  .  .  D1 .  .  .  D1 .  .  .")
    (tick   ".  .  .  .  C4 .  .  .  .  .  .  .  C4 .  C4 .")
    (strain "Eb4 . .  .  .  .  .  .  .  .  .  .  .  .  .  ."))
