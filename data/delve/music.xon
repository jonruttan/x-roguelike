; --- Guardians -----------------------------------------------------------------
;
; A band's guardian, awake and seen or within (boss-near N) cells, has a
; theme of its own, played at once and kept until it dies or the level
; is left.

(boss-near 8)
(boss "fireman" "fireman-theme")
(boss "undertow" "undertow-theme")
(boss "warder" "warder-theme")
(boss "Old Man" "old-man-theme")

