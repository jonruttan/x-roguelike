    (hum   "E1 . . . . . . .")
    (dread "C4 . . . . . . ."))
  (order a))

; --- The Heart: the stone that moves, the quiet water; C, deep and slow ------

(song "heart" (bpm 48) (rows 2) (tension-bpm 40)
  (instrument deep (wave sine) (env (0 0) (2500 40) (6000 34)) (release 3500) (gain 36)
    (voice (pan -30)) (voice (wave hollow) (cut 8) (pan 30) (gain 70)))
  (instrument bell (wave glass) (env (0 0) (4 30) (3500 0)) (release 1500) (gain 18)
    (voice (pan -40)) (voice (pan 40) (detune 8) (gain 50)))
  (instrument pad (layer calm) (wave warm) (cut 10) (env (0 0) (3000 28) (7000 24)) (release 3500) (gain 24)
    (voice (detune -7) (pan -60)) (voice (detune 7) (pan 60)))
  (instrument pulse (layer tension) (wave sine) (cut 40) (env (0 0) (8 90) (220 0)) (release 60) (gain 54))
  (instrument tick (layer tension) (wave noise) (hz 1) (cut 20) (env (0 0) (1 30) (40 0)) (release 20) (gain 20))
  (instrument strain (layer tension) (wave thin) (cut 14) (env (0 0) (1200 24) (3000 20)) (release 1500) (gain 18) (pan 25))
  (pattern ha
    (deep   "C2 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (bell   "G4 .  .  .  .  .  .  .  .  .  .  .  E5 .  .  .")
    (bell   ".  .  .  .  .  .  C5 .  .  .  .  .  .  .  .  .")
    (pad    "E3 .  .  .  .  .  .  .  D3 .  .  .  .  .  .  .")
    (pulse  "C1 .  .  .  .  .  .  .  C1 .  .  .  C1 .  C1 .")
    (tick   ".  .  .  .  .  .  C4 .  .  .  .  .  .  .  C4 .")
    (strain "Db4 . .  .  .  .  .  .  .  .  .  .  .  .  .  ."))
  (pattern hb
    (deep   "Ab1 . .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (bell   "Eb5 . .  .  .  .  .  .  .  .  .  .  C5 .  .  .")
    (bell   ".  .  .  .  .  .  G4 .  .  .  .  .  .  .  .  .")
    (pad    "C3 .  .  .  .  .  .  .  Eb3 . .  .  .  .  .  .")
    (pulse  "Ab0 . .  .  .  .  .  .  Ab0 . .  .  Ab0 . Ab0 .")
    (tick   ".  .  .  .  .  .  C4 .  .  .  .  .  .  .  C4 .")
    (strain "D4 .  .  .  .  .  .  .  .  .  .  .  .  .  .  ."))
  (order ha ha hb))

(song "heart-air" (bpm 60) (rows 1)
  (instrument air (wave noise) (hz 1) (env (0 0) (3500 30) (9000 26)) (release 4500) (gain 28)
    (voice (cut 1) (pan -50)) (voice (cut 2) (pan 50) (detune 35)))
  (instrument hum (wave sine) (env (0 0) (3500 22)) (release 3500) (gain 24))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 60)) (release 3000) (gain 44))
  (pattern a
    (air   "C4 . . . . . . .")
    (hum   "C1 . . . . . . .")
    (dread "C4 . . . . . . ."))
  (order a))

; --- Fights --------------------------------------------------------------------
;
; A blow struck either way brings in the place's fight song, at once,
; until (fight-turns N) turns pass without one; then the place's own
; song comes back at the end of the pattern.  Each is in its band's key,
; fast, 150 to 180 beats a minute, with a drum; its tension layer is
; the hi-hat.

(fight-turns 8)
(fight "default" "galleries-fight")
(fight "The Galleries" "galleries-fight")
(fight "The Flood" "flood-fight")
(fight "The Old Works" "works-fight")
(fight "The Heart" "heart-fight")

(song "galleries-fight" (bpm 172) (rows 2) (tension-bpm 24)
  (instrument kick (wave sine) (hz 72) (slide 38) (env (0 0) (2 95) (110 0)) (release 30) (gain 60))
  (instrument snare (wave noise) (hz 1) (cut 45) (env (0 0) (1 62) (110 0)) (release 30) (gain 32))
  (instrument hats (wave noise) (hz 1) (cut 85) (env (0 0) (1 20) (25 0)) (release 10) (gain 13) (pan 30))
  (instrument open (layer tension) (wave noise) (hz 1) (cut 75) (env (0 0) (1 22) (130 0)) (release 30) (gain 14) (pan -30))
  (instrument bass (wave reed) (cut 18) (env (0 0) (3 62) (110 34) (240 0)) (release 50) (gain 42))
  (instrument stab (wave thin) (cut 32) (env (0 0) (2 42) (150 0)) (release 60) (gain 22) (pan -25))
  (instrument bell (wave glass) (env (0 0) (3 30) (900 0)) (release 300) (gain 16) (pan 30))
  (pattern fa
    (kick  "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4")
    (snare ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  .  C4 .")
    (hats  "C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4")
    (open  ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4")
    (bass  "A1 A1 A2 A1 A1 A1 A2 A1 A1 A1 A2 A1 G1 G1 G#1 G#1")
    (stab  "A3 .  .  A3 .  .  C4 .  .  .  A3 .  E4 .  D4 .")
    (bell  "E5 .  .  .  .  .  .  .  .  .  .  .  .  .  .  ."))
  (pattern fb
    (kick  "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4")
    (snare ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  .  C4 .")
    (hats  "C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4")
    (open  ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4")
    (bass  "F1 F1 F2 F1 F1 F1 F2 F1 E1 E1 E2 E1 E1 E1 G#1 G#1")
    (stab  "F3 .  .  F3 .  .  A3 .  .  .  G#3 . B3 .  E4 .")
    (bell  ".  .  .  .  .  .  .  .  E5 .  .  .  .  .  .  ."))
  (pattern fc
    (kick  "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4 C4 C4")
    (snare ".  .  C4 .  .  .  C4 .  C4 .  C4 C4 C4 C4 C4 C4")
    (hats  "C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 C4 .  .  .  .")
    (open  ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  .  .  .")
    (bass  "A1 A1 A2 A1 A1 A1 A2 A1 F1 F1 F2 F1 E1 E1 E2 E2")
    (stab  "A3 .  .  A3 .  .  C4 .  F3 .  .  F3 E3 .  G#3 ."))
  (order fa fb fa fc))

(song "flood-fight" (bpm 164) (rows 2) (tension-bpm 24)
