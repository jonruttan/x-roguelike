    (pad    "G3 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (pulse  "E1 .  .  .  .  .  .  .  E1 .  .  .  E1 .  .  .")
    (tick   ".  .  .  .  C4 .  .  .  .  .  .  .  C4 .  C4 .")
    (strain "F4 .  .  .  .  .  .  .  .  .  .  .  .  .  .  ."))
  (pattern wb
    (organ  "D2 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
