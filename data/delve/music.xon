    (chant  "D3 .  .  .  E3 .  .  .  F3 .  .  .  E3 .  D3 .")
    (bell   ".  .  .  .  A4 .  .  .  .  .  .  .  .  .  .  .")
    (pad    "F3 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (pulse  "D1 .  .  .  .  .  .  .  D1 .  .  .  D1 .  .  .")
    (tick   ".  .  .  .  C4 .  .  .  .  .  .  .  C4 .  C4 .")
    (strain "Eb4 . .  .  .  .  .  .  .  .  .  .  .  .  .  ."))
  (order wa wa wb wa))

(song "works-air" (bpm 60) (rows 1)
  (instrument air (wave noise) (hz 1) (env (0 0) (3000 30) (8000 26)) (release 4000) (gain 28)
    (voice (cut 2) (pan -50)) (voice (cut 2) (pan 50) (detune 25)))
