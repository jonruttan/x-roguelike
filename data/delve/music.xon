; music.xon -- the delve set's soundtrack and the air of each band, as
; tracker songs (docs/sound.md): instruments, patterns of rows, an order.
;
; Each band has a song and a bed under it.  A song's calm layer plays
; while nothing is near; its tension layer -- a pulse, a tick, a strained
; note held against the drone -- comes in as the tension rises, and the
; tempo with it, by (tension-bpm N) at the most.

(music "default" "galleries")
(music "The Galleries" "galleries")
(music "The Flood" "flood")
(music "The Old Works" "works")
(music "The Heart" "heart")

; --- The Galleries: the worked mine, A minor, slow and spare -------------------

(song "galleries" (bpm 60) (rows 2) (tension-bpm 46)
  (instrument drone (wave hollow) (cut 9) (env (0 0) (1800 45) (5000 35)) (release 3000) (gain 36)
    (voice (detune -5) (pan -45)) (voice (detune 5) (pan 45)))
  (instrument pluck (wave reed) (cut 20) (env (0 0) (4 55) (350 22) (1800 0)) (release 500) (gain 28) (pan 25))
  (instrument bell (wave glass) (env (0 0) (5 34) (2400 0)) (release 900) (gain 20) (pan -30))
  (instrument pad (layer calm) (wave warm) (cut 14) (env (0 0) (2200 34) (6000 28)) (release 3000) (gain 28)
    (voice (detune -8) (pan -60)) (voice (detune 8) (pan 60)))
  (instrument pulse (layer tension) (wave sine) (cut 40) (env (0 0) (6 90) (180 0)) (release 60) (gain 52))
  (instrument tick (layer tension) (wave noise) (hz 1) (cut 26) (env (0 0) (1 34) (35 0)) (release 20) (gain 24) (pan 35))
  (instrument strain (layer tension) (wave thin) (cut 18) (env (0 0) (900 25) (3000 20)) (release 1500) (gain 20) (pan -15))
  (pattern ga
    (drone  "A2 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (pluck  "E4 .  C4 .  .  .  A3 .  .  .  B3 .  C4 .  .  .")
    (bell   ".  .  .  .  .  .  .  .  E5 .  .  .  .  .  .  .")
    (pad    "C4 .  .  .  .  .  .  .  E4 .  .  .  .  .  .  .")
    (pulse  "A1 .  .  .  A1 .  .  .  A1 .  .  .  A1 .  A1 .")
    (tick   ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  C4 C4 .")
    (strain "E3 .  .  .  .  .  .  .  F3 .  .  .  .  .  .  ."))
  (pattern gb
    (drone  "F2 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (pluck  "C4 .  A3 .  .  .  F3 .  .  .  G3 .  A3 .  .  .")
    (bell   ".  .  .  .  .  .  .  .  .  .  .  .  C5 .  .  .")
    (pad    "A3 .  .  .  .  .  .  .  C4 .  .  .  .  .  .  .")
    (pulse  "F1 .  .  .  F1 .  .  .  F1 .  .  .  F1 .  F1 .")
    (tick   ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  C4 C4 .")
    (strain "C3 .  .  .  .  .  .  .  C#3 . .  .  .  .  .  ."))
  (pattern gc
    (drone  "G2 .  .  .  .  .  .  .  E2 .  .  .  .  .  .  .")
    (pluck  "D4 .  B3 .  .  .  G3 .  G#3 . .  .  B3 .  .  .")
    (bell   ".  .  .  .  B4 .  .  .  .  .  .  .  .  .  .  .")
    (pad    "B3 .  .  .  .  .  .  .  G#3 . .  .  .  .  .  .")
    (pulse  "G1 .  .  .  G1 .  .  .  E1 .  .  .  E1 .  E1 .")
    (tick   ".  .  C4 .  .  .  C4 .  .  .  C4 .  C4 C4 C4 .")
    (strain "D3 .  .  .  .  .  .  .  D#3 . .  .  .  .  .  ."))
  (order ga ga gb gc))

(song "galleries-air" (bpm 60) (rows 1)
  (instrument air (wave noise) (hz 1) (env (0 0) (3000 34) (8000 30)) (release 4000) (gain 32)
    (voice (cut 2) (pan -60)) (voice (cut 3) (pan 60) (detune 30)))
  (instrument hum (wave sine) (env (0 0) (3000 18)) (release 3000) (gain 20))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 60)) (release 3000) (gain 44))
  (pattern a
    (air   "C4 . . . . . . .")
    (hum   "A1 . . . . . . .")
    (dread "C4 . . . . . . ."))
  (order a))

; --- The Flood: standing water, D dorian, running one way ---------------------

(song "flood" (bpm 66) (rows 2) (tension-bpm 44)
  (instrument drone (wave warm) (cut 10) (env (0 0) (2000 40) (5000 32)) (release 3000) (gain 34)
    (voice (detune -6) (pan -50)) (voice (detune 6) (pan 50)))
  (instrument ripple (wave glass) (env (0 0) (3 30) (500 8) (1200 0)) (release 400) (gain 18)
    (voice (pan -35)) (voice (pan 35) (detune 7) (gain 60)))
  (instrument low (layer calm) (wave hollow) (cut 12) (env (0 0) (1500 30) (5000 26)) (release 2500) (gain 26))
  (instrument pulse (layer tension) (wave sine) (cut 40) (env (0 0) (6 85) (170 0)) (release 60) (gain 50))
  (instrument tick (layer tension) (wave noise) (hz 1) (cut 30) (env (0 0) (1 28) (30 0)) (release 20) (gain 20) (pan -35))
  (instrument strain (layer tension) (wave thin) (cut 16) (env (0 0) (900 24) (3000 20)) (release 1500) (gain 20) (pan 20))
  (pattern fa
    (drone  "D2 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (ripple "D4 A4 F4 A4 E4 A4 F4 A4 D4 A4 G4 A4 F4 A4 E4 C4")
    (low    "F3 .  .  .  .  .  .  .  A3 .  .  .  .  .  .  .")
    (pulse  "D1 .  .  .  .  .  D1 .  D1 .  .  .  .  .  D1 .")
    (tick   ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4")
    (strain "A3 .  .  .  .  .  .  .  G#3 . .  .  .  .  .  ."))
  (pattern fb
    (drone  "C2 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (ripple "C4 G4 E4 G4 D4 G4 E4 G4 C4 G4 F4 G4 E4 G4 D4 B3")
    (low    "E3 .  .  .  .  .  .  .  G3 .  .  .  .  .  .  .")
    (pulse  "C1 .  .  .  .  .  C1 .  C1 .  .  .  .  .  C1 .")
    (tick   ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4")
    (strain "G3 .  .  .  .  .  .  .  F#3 . .  .  .  .  .  ."))
  (pattern fc
    (drone  "Bb1 . .  .  .  .  .  .  A1 .  .  .  .  .  .  .")
    (ripple "Bb3 F4 D4 F4 C4 F4 D4 F4 A3 E4 C#4 E4 A3 E4 C#4 E4")
    (low    "D3 .  .  .  .  .  .  .  C#3 . .  .  .  .  .  .")
    (pulse  "Bb0 . .  .  .  .  Bb0 . A0 .  .  .  .  .  A0 .")
    (tick   ".  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4")
    (strain "F3 .  .  .  .  .  .  .  E3 .  .  .  .  .  .  ."))
  (order fa fb fa fc))

(song "flood-water" (bpm 60) (rows 1)
  (instrument water (wave noise) (hz 1) (env (0 0) (2500 30) (7000 26)) (release 3500) (gain 30)
    (voice (cut 8) (pan -50)) (voice (cut 6) (pan 50) (detune 40)) (voice (cut 40) (gain 25)))
  (instrument dread (layer tension) (wave noise) (hz 1) (cut 1) (env (0 0) (2000 60)) (release 3000) (gain 42))
  (pattern a
    (water "C4 . . . . . . .")
    (dread "C4 . . . . . . ."))
  (order a))

; --- The Old Works: dressed stone, older than the mine; E, open fifths --------

(song "works" (bpm 54) (rows 2) (tension-bpm 40)
